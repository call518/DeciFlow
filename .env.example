# Common / 공통 설정

# Decision engine: laya (default) or jev (paid TypeSafe API). No automatic fallback.
# 판정 엔진: laya(기본) 또는 jev(유료 TypeSafe API). 자동 전환하지 않습니다.
DECISION_ENGINE=laya

# DeciFlow web server port, independent of the remote Laya server port.
# DeciFlow 웹 서버 포트. 원격 Laya 서버 포트와는 별개입니다.
PORT=4000

# Trusted UI origins for the CSRF Origin check; comma-separated, no trailing slash.
# Supports https://*.ngrok-free.app for changing domains. Empty allows localhost only.
# Origin check only, not login authentication or CSRF token validation. Use proxy authentication.
# CSRF Origin 검사에서 신뢰할 UI 출처. 쉼표 구분, 스킴 포함, 끝에 / 제외.
# 랜덤 도메인은 https://*.ngrok-free.app 지원. 빈 값은 localhost만 허용합니다.
# Origin 검사이며 로그인 인증·CSRF 토큰 검증은 아닙니다. 프록시 인증을 사용하세요.
DECIFLOW_CSRF_TRUSTED_ORIGINS=https://*.ngrok-free.app

# Laya / Laya 엔진 설정

# Full Laya decision URL, including host, port and /v1/systemone (or proxy prefix).
# Replace the loopback example with your remote server URL. Prefer HTTPS externally.
# Laya 판정 URL: 호스트, 포트, /v1/systemone(프록시 접두사 포함 가능)을 지정하세요.
# 로컬 주소 예시를 실제 원격 서버 주소로 변경하세요. 외부 네트워크에서는 HTTPS를 사용하세요.
LAYA_API_URL=http://127.0.0.1:8000/v1/systemone

# Bearer key matching the Laya server. Default: changeme (example only).
# Use a strong key for deployment; set an empty value for a server without authentication.
# Laya 서버와 동일한 인증 키. 기본값: changeme(예시용).
# 실제 배포에는 강한 키를 사용하세요. 인증 없는 서버에는 빈 값으로 설정하세요.
LAYA_API_KEY=changeme

# DeciFlow model selection, sent as the Laya API request's model field.
# Built-ins: english, multilingual, typed-decisions. Not the server's LAYA_MODELS preload list.
# A custom name must be registered on the server; DeciFlow also requires LAYA_MAX_TOKENS.
# DeciFlow accepts model names only, not Hugging Face IDs, URLs or filesystem paths.
# DeciFlow의 모델 선택값이며 Laya API 요청의 model 필드로 전달합니다.
# 내장 선택값: english, multilingual, typed-decisions. 서버의 LAYA_MODELS 사전 적재 목록과 다릅니다.
# 사용자 모델 이름은 서버에 등록해야 하며, DeciFlow에서는 LAYA_MAX_TOKENS도 지정해야 합니다.
# DeciFlow에는 모델 이름만 입력합니다. Hugging Face ID·URL·파일 경로는 지원하지 않습니다.
# Model characteristics and intended uses (all three support choice, score and noul):
# english: English-focused; candidate for short English logs, email triage and guardrails.
# multilingual: Supports 100+ languages; candidate for Korean or mixed-language data.
# typed-decisions: English-based fine-tune for specific decision workflows,
# such as security incident triage, customer service and agent-trace observability.
# It is not a general log specialist; compare models using labeled logs before deployment.
# Source: https://huggingface.co/convaiinnovations/laya
# 모델별 특징·용도(세 모델 모두 choice·score·noul 지원):
# english: 영어 중심. 짧은 영어 로그, 이메일 분류·안전 정책 판정의 후보 모델.
# multilingual: 100개 이상 언어 지원. 한국어·여러 언어가 섞인 데이터의 후보 모델.
# typed-decisions: 영어 기반으로 특정 의사결정 업무에 추가 학습한 모델.
# 보안 사건 분류, 고객 서비스, 에이전트 실행 기록 분석 등의 업무에 특화.
# 범용 로그 특화 모델은 아니므로, 운영 적용 전 정답 로그로 모델별 성능을 비교하세요.
LAYA_MODEL=typed-decisions

# DeciFlow-only total budget sent as Laya API max_len. Blank keeps built-in defaults.
# english: 1..512; other built-ins: 1..8192. Must exceed LAYA_HEAD_TOKENS.
# Custom models require an explicit value (1..8192) verified for that checkpoint.
# The remote server cap also applies. Ignored by Jev.
# DeciFlow 전용 전체 예산: Laya API max_len으로 전달. 빈 값은 내장 모델 기본값 유지.
# english 1~512, 나머지 내장 모델 1~8192. LAYA_HEAD_TOKENS보다 커야 합니다.
# 사용자 모델은 검증한 값(1~8192)을 반드시 명시하세요. 원격 서버 상한도 적용됩니다.
# Jev에서는 사용하지 않습니다.
LAYA_MAX_TOKENS=8192

# DeciFlow-only setting sent as Laya API head_max_len; not a Laya server env var.
# Example: LAYA_HEAD_TOKENS=384 sends "head_max_len": 384 on every Laya request.
# 예: LAYA_HEAD_TOKENS=384이면 모든 Laya 요청에 "head_max_len": 384를 전송합니다.
# Default 256 is NOT a maximum. Must be positive and below effective LAYA_MAX_TOKENS.
# Default-window ranges: english 1..511; other built-ins 1..8191. Server caps apply.
# Laya v0.4.1 server cap: LAYA_MAX_TOKEN_BUDGET (default 8192). Ignored by Jev.
# Larger rendered questions can leave less room for logs; this does not change weights.
# DeciFlow 전용 설정: Laya API의 head_max_len으로 전달하며 서버 환경변수가 아닙니다.
# 256은 최대값이 아닌 기본값. 양의 정수이며 적용되는 전체 토큰 예산보다 작아야 합니다.
# 기본 윈도 범위: english 1~511, 나머지 내장 모델 1~8191. 서버 상한도 적용됩니다.
# Laya v0.4.1 서버 상한: LAYA_MAX_TOKEN_BUDGET(기본 8192). Jev에서는 무시합니다.
# 실제 질문이 커지면 로그 공간이 줄 수 있으며 모델 가중치는 바꾸지 않습니다.
LAYA_HEAD_TOKENS=256

# Maximum simultaneous requests per run; positive integers. Defaults: 4 each.
# 실행별 최대 동시 요청 수. 양의 정수이며 각 기본값은 4입니다.
# Only the selected engine's setting applies; this does not set Laya server workers.
# 선택한 엔진의 설정만 적용하며 Laya 서버의 워커 수를 설정하지 않습니다.
LAYA_CONCURRENCY=4

# Jev / Jev 엔진 설정

# TypeSafe Jev API key, used only with DECISION_ENGINE=jev. Never commit it.
# TypeSafe Jev API 키. DECISION_ENGINE=jev일 때만 사용하며 커밋하지 마세요.
JEV_API_KEY=

# DeciFlow model selection, sent as the TypeSafe API request's model field.
# jev-1.13.0: pinned version; recommended for repeatable production evaluations.
# jev-latest: latest stable release; jev-preview: latest release, including previews.
# Aliases can move to new versions; they are not separate language/task models.
# Jev supports choice, score and noul for classification, routing and rubric judgments.
# English is its strongest language; validate Korean and other languages on your data.
# Text/JSON input only; logs use choice in DeciFlow. Hosted API usage incurs charges.
# Source: https://docs.typesafe.ai/models
# DeciFlow의 모델 선택값이며 TypeSafe API 요청의 model 필드로 전달합니다.
# jev-1.13.0: 고정 버전. 운영 환경의 반복 평가·동작 비교에 권장합니다.
# jev-latest: 최신 안정 버전. jev-preview: 미리보기까지 포함한 최신 버전.
# 별칭은 새 버전으로 바뀔 수 있으며, 언어·업무별로 특화된 별도 모델이 아닙니다.
# Jev는 분류·라우팅·기준별 판정을 위한 choice·score·noul을 지원합니다.
# 영어에서 가장 좋은 성능을 보이며, 한국어·다른 언어는 실제 데이터로 검증하세요.
# 텍스트·JSON 입력만 지원. DeciFlow 로그 분류는 choice를 사용하며 API 비용이 발생합니다.
JEV_MODEL=jev-latest

# Jev only: conservative UTF-8 JSON byte budget per request, including the question.
# Not a token count. Jev 1.13: state + longest question <=32k tokens; full request <=64k.
# Accepts 1..30000. Oversized events are retained for review; ignored by Laya.
# Jev 전용: 질문을 포함한 요청별 보수적인 UTF-8 JSON 바이트 예산이며 토큰 수가 아닙니다.
# Jev 1.13: state + 가장 긴 질문은 32k 토큰, 전체 요청은 64k 토큰 이내입니다.
# 1~30000으로 설정하세요. 초과 이벤트는 검토 대상으로 보존하며 Laya에서는 사용하지 않습니다.
JEV_MAX_INPUT_BYTES=30000

# Maximum simultaneous requests per run; positive integers. Defaults: 4 each.
# 실행별 최대 동시 요청 수. 양의 정수이며 각 기본값은 4입니다.
# Only the selected engine's setting applies; this does not set Laya server workers.
# 선택한 엔진의 설정만 적용하며 Laya 서버의 워커 수를 설정하지 않습니다.
JEV_CONCURRENCY=4
